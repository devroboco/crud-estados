{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",                  
    "moduleResolution": "NodeNext",          
    
    "rootDir": "./src",                    
    "outDir": "./dist",                    
    
   
    "allowJs": true,
    "checkJs": false,
    "sourceMap": true,
    "declaration": false,                 
  
    "strict": true,
    "alwaysStrict": true,
    "forceConsistentCasingInFileNames": true,
    "useUnknownInCatchVariables": true,    
    
    "skipLibCheck": true,                  
    "esModuleInterop": true,                
    
    "types": ["node"]
  },
  "include": [
    "src/**/*"                             
  ],
  "exclude": [
    "node_modules",                        
    "dist"
  ]
}